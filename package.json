{
  "name": "storybook-addon-vue-mdx",
  "version": "2.0.2",
  "description": "Use Vue components inside MDX files, as if they were React components.",
  "keywords": [
    "storybook-addon",
    "organize",
    "documentation",
    "vue",
    "mdx"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Sidnioulz/storybook-addon-vue-mdx.git"
  },
  "author": "Steve Dodier-Lazaro <sidnioulz@gmail.com>",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./preset": "./dist/preset.js",
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "jsx-dev-runtime.js",
    "jsx-runtime.js",
    "manager.js",
    "preset.js",
    "preview.js"
  ],
  "bundler": {
    "jsxEntries": [
      "src/index.ts",
      "src/jsx-runtime.ts"
    ],
    "managerEntries": [
      "src/manager.ts"
    ],
    "nodeEntries": [
      "src/preset.ts",
      "src/index.ts"
    ],
    "previewEntries": [
      "src/preview.ts"
    ]
  },
  "scripts": {
    "build-storybook": "storybook build",
    "build": "tsup",
    "build:watch": "pnpm build --watch",
    "eject-ts": "zx scripts/eject-typescript.mjs",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm lint --fix",
    "pack:local": "pnpm pack --out storybook-addon-vue-mdx-$(date +%s).tgz",
    "prebuild": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "prepack:local": "pnpm build",
    "prepare": "husky",
    "release": "pnpm build && pnpm semantic-release",
    "release:canary": "pnpm build && node scripts/release-canary.mjs",
    "start": "run-p build:watch 'storybook'",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-react/eslint-plugin": "^5.30.2",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "next",
    "@storybook/builder-vite": "next",
    "@storybook/icons": "^2.2.0",
    "@storybook/react-vite": "next",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "commitlint": "^21.2.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-storybook": "next",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semantic-release": "^25.0.9",
    "storybook": "next",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vuestic-ui": "^1.10.3",
    "zx": "^8.8.5"
  },
  "peerDependencies": {
    "@storybook/addon-docs": "^11.0.0",
    "@storybook/builder-vite": "^11.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "storybook": "^11.0.0",
    "vue": "^3.4.31"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "storybook": {
    "displayName": "Vue support for MDX",
    "supportedFrameworks": [
      "vue"
    ],
    "icon": "https://user-images.githubusercontent.com/321738/63501763-88dbf600-c4cc-11e9-96cd-94adadc2fd72.png"
  },
  "dependencies": {
    "veaury": "^2.6.3"
  }
}
